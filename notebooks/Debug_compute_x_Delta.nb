    RowBox[{
     RowBox[{"centerRes", "[", "\"\<Center\>\"", "]"}], "[", "\"\<Delta\>\"", 
     "]"}], "/", "Degree"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dDeltadeg", "=", 
