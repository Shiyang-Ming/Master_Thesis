      RowBox[{"{", 
       RowBox[{"\"\<R00\>\"", ",", "R000", ",", "R00Err"}], "}"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"centerRes", "=", 
    RowBox[{"ComputeXDeltaCenter", "[", 
     RowBox[{"inputs", ",", 
      RowBox[{"\"\<DeltaStepDeg\>\"", "->", "1"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"compute", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"in", ",", 
     RowBox[{"ComputeXDeltaCenter", "[", 
      RowBox[{"in", ",", 
       RowBox[{"\"\<DeltaStepDeg\>\"", "->", "1"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"scalarExtractor", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"res", ",", 
     RowBox[{"res", "[", "\"\<Center\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"curveExtractor", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"res", ",", 
      RowBox[{"res", "[", "\"\<Curves\>\"", "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uncRes", "=", 
    RowBox[{"ComputeUncertaintyFD", "[", 
     RowBox[{
     "compute", ",", "scalarExtractor", ",", "curveExtractor", ",", "inputs", 
      ",", "paramSpecs"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{
    RowBox[{"centerRes", "[", "\"\<Center\>\"", "]"}], "[", "\"\<x\>\"", 
