    RowBox[{"Import", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "projectDir", ",", "\"\<results\>\"", ",", "\"\<B_pipi_R00_Rpm\>\"", 
        ",", "\"\<Rpm.mx\>\""}], "}"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"inputs", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<A\>\"", "->", "Acppippim0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<S\>\"", "->", "Scppippim0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<gamma\>\"", "->", "gamma0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<phid\>\"", "->", "phid0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<Rpm\>\"", "->", "Rpm0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<R00\>\"", "->", "R000"}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<Acp00\>\"", "->", "Acppi0pi00"}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"paramSpecs", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<A\>\"", ",", "Acppippim0", ",", "AcppippimErr"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<S\>\"", ",", "Scppippim0", ",", "ScppippimErr"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<gamma\>\"", ",", "gamma0", ",", "gammaErr"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<phid\>\"", ",", "phid0", ",", "phidErr"}], "}"}], ",", 
