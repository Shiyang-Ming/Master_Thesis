 RowBox[{
  RowBox[{
   RowBox[{"dx", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"uncRes", "[", "\"\<Scalars\>\"", "]"}], "[", "\"\<Sigma\>\"", 
      "]"}], "[", "\"\<x\>\"", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Delta0deg", "=", 
