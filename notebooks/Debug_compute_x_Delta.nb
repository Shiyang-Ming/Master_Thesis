 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"R000", ",", "R00Err"}], "}"}], "=", 
   RowBox[{"Import", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "projectDir", ",", "\"\<results\>\"", ",", "\"\<B_pipi_R00_Rpm\>\"", 
       ",", "\"\<R00.mx\>\""}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
